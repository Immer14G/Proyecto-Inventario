@model miPrimerProyecto.Models.Inventario

<h2>Eliminar Inventario</h2>

<p>¿Estás seguro de que deseas eliminar este inventario?</p>

<dl class="row">
    <dt class="col-sm-2">Producto:</dt>
    <dd class="col-sm-10">@Model.Producto.Nombre</dd>

    <dt class="col-sm-2">Cantidad:</dt>
    <dd class="col-sm-10">@Model.Cantidad</dd>
</dl>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
